APP_NAME=DayLog
DEBUG=true
BASE_URL=http://127.0.0.1:8000        # public URL of the site, used for cookies + Google redirect
SECRET_KEY=change-me                   # python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_DAYS=7

# Neon: copy the connection string from the Neon dashboard and change the prefix to postgresql+psycopg://
# Keep sslmode=require. Use a separate Neon branch for development.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LLM_PROVIDER=gemini                    # "gemini" or "groq"
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

DEFAULT_TIMEZONE=Asia/Kolkata

# Dev only: extra browser origins allowed to make unsafe requests (Vite dev server).
# Leave empty in production so only BASE_URL's origin is accepted.
DEV_ALLOWED_ORIGINS=

# Local testing only (scripts/smoke_test.py)
SMOKE_LLM_KEY=
